# ===========================
# DEPENDE ROUTE CLUB - .gitignore
# ===========================

# ===========================
# Dados Pessoais (NUNCA commitar)
# ===========================
*.csv
profile.jpg
activities/
media/
clubs/

# ===========================
# Ambiente e Segredos
# ===========================
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# ===========================
# Firebase
# ===========================
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*.log

# ===========================
# Node.js
# ===========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ===========================
# Python
# ===========================
*.py
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
venv/
.venv/

# ===========================
# IDEs e Editores
# ===========================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ===========================
# Sistema Operacional
# ===========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
nul

# ===========================
# Arquivos Temporarios
# ===========================
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# ===========================
# Build e Cache
# ===========================
dist/
build/
.cache/
*.cache

# ===========================
# Scripts Locais
# ===========================
*.bat
*.sh
!firebase-messaging-sw.js
!sw.js

# ===========================
# Claude Code
# ===========================
.claude/
